{
    "name": "toolkit-pro",
    "version": "2.0.0",
    "description": "বিশ্বের সবচেয়ে সম্পূর্ণ ও শক্তিশালী অনলাইন টুলস প্ল্যাটফর্ম - Frontend",
    "private": true,
    "type": "module",
    "author": {
        "name": "Toolkit Pro Team",
        "email": "support@toolkitpro.com",
        "url": "https://toolkitpro.com"
    },
    "license": "MIT",
    "keywords": [
        "toolkit",
        "tools",
        "laravel",
        "vue",
        "tailwindcss",
        "vite"
    ],
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "watch": "vite build --watch",
        "prod": "vite build --mode production",
        "test": "vitest",
        "test:unit": "vitest run --coverage",
        "test:e2e": "cypress run",
        "test:e2e:open": "cypress open",
        "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix",
        "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs",
        "format": "prettier --write \"resources/**/*.{js,vue,css,scss,json,md}\"",
        "format:check": "prettier --check \"resources/**/*.{js,vue,css,scss,json,md}\"",
        "type-check": "vue-tsc --noEmit",
        "analyze": "vite build --mode analyze",
        "storybook": "storybook dev -p 6006",
        "storybook:build": "storybook build",
        "prepare": "husky install"
    },
    "dependencies": {
        "@headlessui/vue": "^1.7.16",
        "@heroicons/vue": "^2.0.18",
        "@inertiajs/vue3": "^1.0.14",
        "@popperjs/core": "^2.11.8",
        "@tailwindcss/forms": "^0.5.7",
        "@tailwindcss/typography": "^0.5.10",
        "@tailwindcss/aspect-ratio": "^0.4.2",
        "@tailwindcss/container-queries": "^0.1.1",
        "@vueuse/core": "^10.5.0",
        "@vueuse/integrations": "^10.5.0",
        "axios": "^1.6.2",
        "chart.js": "^4.4.1",
        "clipboard": "^2.0.11",
        "codemirror": "^6.0.1",
        "cropperjs": "^1.6.1",
        "dayjs": "^1.11.10",
        "dropzone": "^6.0.0-beta.2",
        "echarts": "^5.4.3",
        "filepond": "^4.30.4",
        "flatpickr": "^4.6.13",
        "highlight.js": "^11.9.0",
        "html2canvas": "^1.4.1",
        "i18next": "^23.7.6",
        "i18next-vue": "^4.0.0",
        "lodash-es": "^4.17.21",
        "moment": "^2.29.4",
        "nprogress": "^0.2.0",
        "pdf-lib": "^1.17.1",
        "pinia": "^2.1.7",
        "plyr": "^3.7.8",
        "pusher-js": "^8.4.0",
        "qrcode": "^1.5.3",
        "quill": "^2.0.0",
        "select2": "^4.1.0-rc.0",
        "sortablejs": "^1.15.0",
        "sweetalert2": "^11.10.1",
        "three": "^0.160.0",
        "tippy.js": "^6.3.7",
        "toastify-js": "^1.12.0",
        "vue": "^3.3.11",
        "vue-chartjs": "^5.3.0",
        "vue-clipboard3": "^2.0.0",
        "vue-color": "^2.8.1",
        "vue-draggable-plus": "^0.4.0",
        "vue-i18n": "^9.8.0",
        "vue-multiselect": "^3.0.0",
        "vue-router": "^4.2.5",
        "vue-select": "^4.0.0-beta.6",
        "vue-toastification": "^2.0.0-rc.5",
        "vue3-apexcharts": "^1.5.2",
        "vuedraggable": "^4.1.0",
        "vite-plugin-pwa": "^0.17.4",
        "web3": "^4.3.0"
    },
    "devDependencies": {
        "@babel/core": "^7.23.5",
        "@babel/preset-env": "^7.23.5",
        "@pinia/testing": "^0.1.3",
        "@rushstack/eslint-patch": "^1.6.0",
        "@storybook/addon-essentials": "^7.6.4",
        "@storybook/addon-links": "^7.6.4",
        "@storybook/blocks": "^7.6.4",
        "@storybook/vue3": "^7.6.4",
        "@storybook/vue3-vite": "^7.6.4",
        "@testing-library/jest-dom": "^6.1.5",
        "@testing-library/vue": "^8.0.1",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^20.10.4",
        "@typescript-eslint/eslint-plugin": "^6.13.2",
        "@typescript-eslint/parser": "^6.13.2",
        "@vitejs/plugin-vue": "^4.5.2",
        "@vitest/coverage-v8": "^1.0.4",
        "@vue/compiler-sfc": "^3.3.11",
        "@vue/eslint-config-prettier": "^8.0.0",
        "@vue/eslint-config-typescript": "^12.0.0",
        "@vue/test-utils": "^2.4.3",
        "autoprefixer": "^10.4.16",
        "cypress": "^13.6.1",
        "eslint": "^8.55.0",
        "eslint-plugin-cypress": "^2.15.1",
        "eslint-plugin-vue": "^9.19.2",
        "husky": "^8.0.3",
        "jsdom": "^23.0.1",
        "laravel-vite-plugin": "^1.0.2",
        "lint-staged": "^15.2.0",
        "postcss": "^8.4.32",
        "prettier": "^3.1.1",
        "prettier-plugin-tailwindcss": "^0.5.9",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "sass": "^1.69.5",
        "storybook": "^7.6.4",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.3.3",
        "vite": "^5.0.10",
        "vite-plugin-compression": "^0.5.1",
        "vite-plugin-eslint": "^1.8.1",
        "vite-plugin-pwa": "^0.17.4",
        "vite-plugin-vue-devtools": "^7.0.0",
        "vitest": "^1.0.4",
        "vue-tsc": "^1.8.25"
    },
    "lint-staged": {
        "*.{js,vue}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{css,scss,json,md}": [
            "prettier --write"
        ]
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged",
            "pre-push": "npm run test:unit"
        }
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead",
        "not ie 11"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/yourusername/toolkit-pro.git"
    },
    "bugs": {
        "url": "https://github.com/yourusername/toolkit-pro/issues",
        "email": "support@toolkitpro.com"
    },
    "homepage": "https://toolkitpro.com"
}
