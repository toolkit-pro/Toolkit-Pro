# ===================
# অ্যাপ্লিকেশন সেটিংস
# ===================
APP_NAME="Toolkit Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# ===================
# PHP কনফিগারেশন
# ===================
PHP_VERSION=8.1
BCRYPT_ROUNDS=12

# ===================
# লগিং কনফিগারেশন
# ===================
LOG_CHANNEL=stack
LOG_STACK=single,daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===================
# ডাটাবেস কনফিগারেশন
# ===================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=toolkit_pro
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_SSL_MODE=prefer

# PostgreSQL রিড রেপ্লিকা (ঐচ্ছিক)
DB_READ_HOST=127.0.0.1
DB_READ_PORT=5432

# Redis কনফিগারেশন
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ===================
# ক্যাশ কনফিগারেশন
# ===================
CACHE_DRIVER=redis
CACHE_PREFIX=toolkit_cache
CACHE_TTL=3600

# ===================
# সেশন কনফিগারেশন
# ===================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ===================
# কিউ কনফিগারেশন
# ===================
QUEUE_CONNECTION=redis
QUEUE_DEFAULT=default
QUEUE_RETRY_AFTER=90
QUEUE_TIMEOUT=60

# Horizon (কিউ মনিটরিং)
HORIZON_PREFIX=horizon_toolkit
HORIZON_DARK_MODE=true

# ===================
# ব্রডকাস্টিং / WebSocket
# ===================
BROADCAST_DRIVER=redis
PUSHER_APP_ID=toolkit-pro
PUSHER_APP_KEY=toolkit_websocket_key
PUSHER_APP_SECRET=toolkit_websocket_secret
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# ===================
# মেইল কনফিগারেশন
# ===================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@toolkitpro.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS=support@toolkitpro.com

# ===================
# ফাইল স্টোরেজ
# ===================
FILESYSTEM_DISK=local
FILESYSTEM_DEFAULT=local

# AWS S3 (প্রোডাকশন)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=toolkit-pro-storage
AWS_URL=https://s3.amazonaws.com/toolkit-pro-storage
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (বিকল্প)
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=toolkit-pro
R2_URL=https://your-account.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com

# ===================
# সার্চ ইঞ্জিন
# ===================
SCOUT_DRIVER=elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_INDEX=toolkit_pro

# Meilisearch (বিকল্প)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=masterKey

# ===================
# AI সার্ভিস
# ===================
# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_ORGANIZATION=your_org_id
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Google AI
GOOGLE_AI_API_KEY=your_google_ai_key
GOOGLE_AI_MODEL=gemini-pro

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_key
ANTHROPIC_MODEL=claude-3

# Hugging Face
HUGGINGFACE_API_KEY=your_huggingface_key
HUGGINGFACE_MODEL=mistralai/Mixtral-8x7B

# ===================
# পেমেন্ট গেটওয়ে
# ===================
# Stripe
STRIPE_KEY=your_stripe_publishable_key
STRIPE_SECRET=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_CURRENCY=usd

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_MODE=sandbox

# SSLCommerz (বাংলাদেশ)
SSLCZ_STORE_ID=your_sslcz_store_id
SSLCZ_STORE_PASSWORD=your_sslcz_password
SSLCZ_MODE=sandbox

# bKash (বাংলাদেশ)
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_MODE=sandbox

# Razorpay
RAZORPAY_KEY=your_razorpay_key
RAZORPAY_SECRET=your_razorpay_secret

# ===================
# ব্লকচেইন
# ===================
# Ethereum
ETHEREUM_NODE_URL=https://mainnet.infura.io/v3/your-project-id
ETHEREUM_CHAIN_ID=1
ETHEREUM_GAS_LIMIT=500000
ETHEREUM_GAS_PRICE=auto

# Binance Smart Chain
BSC_NODE_URL=https://bsc-dataseed.binance.org
BSC_CHAIN_ID=56

# Polygon
POLYGON_NODE_URL=https://polygon-rpc.com
POLYGON_CHAIN_ID=137

# Web3
WEB3_PROVIDER=https://mainnet.infura.io/v3/your-project-id
WEB3_NETWORK=mainnet

# Smart Contract Addresses
CONTRACT_TOOLKIT_TOKEN=0x0000000000000000000000000000000000000000
CONTRACT_MARKETPLACE=0x0000000000000000000000000000000000000000
CONTRACT_NFT=0x0000000000000000000000000000000000000000

# ===================
# সিকিউরিটি
# ===================
# JWT
JWT_SECRET=your_jwt_secret_key
JWT_TTL=1440
JWT_REFRESH_TTL=20160

# OAuth
OAUTH_GITHUB_CLIENT_ID=your_github_client_id
OAUTH_GITHUB_CLIENT_SECRET=your_github_client_secret
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret
OAUTH_FACEBOOK_CLIENT_ID=your_facebook_client_id
OAUTH_FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# 2FA
TWO_FACTOR_ENABLED=true
TWO_FACTOR_PROVIDER=google
TWO_FACTOR_TIMEOUT=300

# Encryption
APP_CIPHER=AES-256-CBC
APP_KEY_BASE64=

# ===================
# CDN
# ===================
CDN_URL=https://cdn.toolkitpro.com
CDN_ENABLED=true
CDN_PROVIDER=cloudflare

# Cloudflare
CLOUDFLARE_API_TOKEN=your_cloudflare_token
CLOUDFLARE_ZONE_ID=your_zone_id
CLOUDFLARE_EMAIL=your_email@example.com

# ===================
# মনিটরিং
# ===================
# Sentry
SENTRY_LARAVEL_DSN=your_sentry_dsn
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=your_grafana_api_key

# ===================
# অ্যানালিটিক্স
# ===================
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX
FACEBOOK_PIXEL_ID=your_pixel_id
HOTJAR_ID=your_hotjar_id

# ===================
# সোশ্যাল মিডিয়া
# ===================
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_PAGE_ID=your_page_id
FACEBOOK_ACCESS_TOKEN=your_access_token

TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_secret

LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# ===================
# SMS সার্ভিস
# ===================
# Twilio
TWILIO_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_number

# Vonage (Nexmo)
VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret
VONAGE_SMS_FROM=ToolkitPro

# ===================
# পুশ নোটিফিকেশন
# ===================
FIREBASE_CREDENTIALS=storage/firebase-credentials.json
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
FCM_SERVER_KEY=your_fcm_server_key
FCM_SENDER_ID=your_sender_id

# OneSignal
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_api_key

# ===================
# ফাইল প্রসেসিং
# ===================
# Image Processing
IMAGE_DRIVER=gd
IMAGE_QUALITY=80
IMAGE_MAX_WIDTH=2048
IMAGE_MAX_HEIGHT=2048

# Video Processing (FFmpeg)
FFMPEG_BIN_PATH=/usr/bin/ffmpeg
FFPROBE_BIN_PATH=/usr/bin/ffprobe
VIDEO_MAX_DURATION=300
VIDEO_MAX_SIZE=100

# PDF Processing
PDF_DRIVER=dompdf
PDF_BINARY=/usr/bin/wkhtmltopdf

# OCR
OCR_ENGINE=tesseract
TESSERACT_PATH=/usr/bin/tesseract
OCR_LANGUAGES=ben+eng

# ===================
# রেট লিমিটিং
# ===================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=100
RATE_LIMIT_DECAY_MINUTES=60
RATE_LIMIT_BY=ip

# API রেট লিমিট
API_RATE_LIMIT_FREE=100
API_RATE_LIMIT_PRO=10000
API_RATE_LIMIT_ENTERPRISE=100000

# ===================
# গেমিফিকেশন
# ===================
POINTS_DAILY_LOGIN=5
POINTS_TOOL_USE=10
POINTS_TOOL_RATING=5
POINTS_TOOL_REVIEW=20
POINTS_TOOL_SHARE=15
POINTS_REFERRAL=100
POINTS_STREAK_BONUS=25

# ===================
# মার্কেটপ্লেস
# ===================
MARKETPLACE_COMMISSION=10
MARKETPLACE_MIN_PRICE=1
MARKETPLACE_MAX_PRICE=10000
MARKETPLACE_CURRENCY=USD

# ===================
# ইমেইল নোটিফিকেশন
# ===================
NOTIFY_EMAIL_ENABLED=true
NOTIFY_EMAIL_TEMPLATE=default
NOTIFY_ADMIN_EMAIL=admin@toolkitpro.com

# ===================
# ডিবাগিং টুলস
# ===================
TELESCOPE_ENABLED=true
TELESCOPE_PATH=telescope
DEBUG_BAR_ENABLED=false
IGNITION_ENABLED=true

# ===================
# লোকালাইজেশন
# ===================
DEFAULT_LANGUAGE=bn
SUPPORTED_LANGUAGES=bn,en,hi,ar,es,fr,de,pt,ru,zh,ja,ko
TRANSLATION_API_KEY=your_translation_api_key

# ===================
# সিডিউলার
# ===================
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Dhaka
BACKUP_SCHEDULE=daily
REPORT_SCHEDULE=weekly
CLEANUP_SCHEDULE=monthly

# ===================
# অ্যাডভান্সড সেটিংস
# ===================
# Feature Flags
FEATURE_AI_ENABLED=true
FEATURE_BLOCKCHAIN_ENABLED=true
FEATURE_MARKETPLACE_ENABLED=true
FEATURE_SOCIAL_ENABLED=true
FEATURE_GAMIFICATION_ENABLED=true
FEATURE_AR_VR_ENABLED=true
FEATURE_VOICE_ENABLED=true

# Performance
PERFORMANCE_CACHE_ENABLED=true
PERFORMANCE_QUERY_CACHE=true
PERFORMANCE_HTTP_CACHE=true
PERFORMANCE_COMPRESSION=true

# Security Headers
SECURITY_HSTS=true
SECURITY_X_FRAME_OPTIONS=SAMEORIGIN
SECURITY_X_CONTENT_TYPE_OPTIONS=nosniff
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_CSP_ENABLED=true
