# ===================
# GitHub Files
# ===================
.github/** text eol=lf
LICENSE text eol=lf
CHANGELOG.md text eol=lf
CONTRIBUTING.md text eol=lf
CODE_OF_CONDUCT.md text eol=lf
SECURITY.md text eol=lf

# ===================
# Export Ignore
# ===================
# ফাইলগুলো গিট আর্কাইভে অন্তর্ভুক্ত হবে না
.gitattributes export-ignore
.gitignore export-ignore
.editorconfig export-ignore
.travis.yml export-ignore
.phpunit.result.cache export-ignore
.github/ export-ignore
tests/ export-ignore
docs/ export-ignore
docker/ export-ignore
node_modules/ export-ignore
vendor/ export-ignore

# ===================
# Linguistic Detection
# ===================
# ভাষা পরিসংখ্যানের জন্য
*.php linguist-language=PHP
*.js linguist-language=JavaScript
*.vue linguist-language=Vue
*.css linguist-language=CSS
*.scss linguist-language=SCSS
*.html linguist-language=HTML
*.blade.php linguist-language=Blade
*.md linguist-language=Markdown
*.json linguist-language=JSON
*.xml linguist-language=XML
*.yml linguist-language=YAML

# ===================
# Diff Settings
# ===================
# বড় ফাইলের জন্য
*.min.js -diff
*.min.css -diff
package-lock.json -diff
composer.lock -diff
yarn.lock -diff
pnpm-lock.yaml -diff

# ===================
# Merge Strategy
# ===================
# বাইনারি ফাইলের জন্য মার্জ কৌশল
*.png merge=binary
*.jpg merge=binary
*.jpeg merge=binary
*.gif merge=binary
*.ico merge=binary
*.pdf merge=binary
*.zip merge=binary
*.tar merge=binary
*.gz merge=binary

# ===================
# Custom Merge Drivers
# ===================
# composer.lock এর জন্য কাস্টম মার্জ
composer.lock merge=ours

# package-lock.json এর জন্য কাস্টম মার্জ
package-lock.json merge=ours

# ===================
# Whitespace Settings
# ===================
# PHP ফাইলে whitespace গুরুত্বপূর্ণ
*.php whitespace=trailing-space,space-before-tab

# JavaScript ফাইলে whitespace গুরুত্বপূর্ণ
*.js whitespace=trailing-space,space-before-tab

# Markdown ফাইলে trailing whitespace গুরুত্বপূর্ণ
*.md whitespace=trailing-space

# ===================
# Large File Settings
# ===================
# ৫০MB এর বেশি ফাইল LFS ব্যবহার করবে
*.psd filter=lfs diff=lfs merge=lfs -text
*.ai filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.mkv filter=lfs diff=lfs merge=lfs -text

# ===================
# EOL Normalization
# ===================
# Windows batch files CRLF ব্যবহার করবে
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts LF ব্যবহার করবে
*.sh text eol=lf
*.bash text eol=lf

# ===================
# Generated Files
# ===================
# জেনারেটেড ফাইল গিট ডিফে দেখানো হবে না
public/build/** -diff
public/js/** -diff
public/css/** -diff
storage/framework/** -diff
storage/logs/** -diff

# ===================
# Documentation
# ===================
# ডকুমেন্টেশন ফাইল
docs/** linguist-documentation
documentation/** linguist-documentation
wiki/** linguist-documentation

# ===================
# Vendored Files
# ===================
# ভেন্ডর ফাইল ভাষা পরিসংখ্যানে গণনা হবে না
vendor/** linguist-vendored
node_modules/** linguist-vendored
bower_components/** linguist-vendored

# ===================
# Generated Files
# ===================
# জেনারেটেড ফাইল ভাষা পরিসংখ্যানে গণনা হবে না
package-lock.json linguist-generated
composer.lock linguist-generated
yarn.lock linguist-generated
pnpm-lock.yaml linguist-generated
